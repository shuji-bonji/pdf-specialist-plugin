{
  "$schema": "https://raw.githubusercontent.com/anthropics/claude-code/main/.claude-plugin/plugin.schema.json",
  "name": "pdf-specialist",
  "version": "0.1.0",
  "description": "An all-in-one plugin for the pdf-specialist subagent: auditing, verifying, producing and looking up the specification for PDFs. Bundles the four PDF Family MCP servers (pdf-reader / pdf-spec / pdf-verify / pdf-writer) with the pdf-trust and pdf-publish Skills. Verdicts come from evaluate_policy (a deterministic rule engine) and veraPDF; the agent orchestrates and explains, and never overrides them.",
  "author": {
    "name": "shuji-bonji",
    "email": "bonji@mikuro.jp",
    "url": "https://github.com/shuji-bonji"
  },
  "homepage": "https://github.com/shuji-bonji/pdf-specialist-plugin",
  "repository": "https://github.com/shuji-bonji/pdf-specialist-plugin",
  "license": "MIT",
  "keywords": [
    "pdf",
    "agent",
    "subagent",
    "specialist",
    "audit",
    "digital-signature",
    "pdf-a",
    "pdf-ua",
    "pades",
    "verapdf",
    "mcp",
    "skill"
  ],
  "mcpServers": {
    "pdf-reader": {
      "command": "npx",
      "args": ["-y", "@shuji-bonji/pdf-reader-mcp@latest"]
    },
    "pdf-spec": {
      "command": "npx",
      "args": ["-y", "@shuji-bonji/pdf-spec-mcp@latest"]
    },
    "pdf-verify": {
      "command": "npx",
      "args": ["-y", "@shuji-bonji/pdf-verify-mcp@latest"]
    },
    "pdf-writer": {
      "command": "npx",
      "args": ["-y", "@shuji-bonji/pdf-writer-mcp@latest"]
    }
  }
}
